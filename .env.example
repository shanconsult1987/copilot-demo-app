# ─────────────────────────────────────────────────────────────────────────────
# Azure AD / Microsoft Entra ID — required for authentication
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Directory (tenant) ID from your Entra ID app registration.
# Found in: Azure Portal → Microsoft Entra ID → App registrations → <your app> → Overview
AZURE_TENANT_ID=your-tenant-id-here

# Application (client) ID of *this* API's app registration.
AZURE_CLIENT_ID=your-client-id-here

# (Optional) Override the authority URL. Defaults to the v2 endpoint for the
# tenant above. Change only if you use a sovereign cloud (e.g. GovCloud).
# AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# (Optional) Override the expected audience claim in incoming JWT tokens.
# Defaults to AZURE_CLIENT_ID.  Set this to the full App ID URI if you
# configured one (e.g. api://<your-client-id> or https://myapp.example.com).
# AZURE_CLIENT_ID_AUDIENCE=api://your-client-id-here
